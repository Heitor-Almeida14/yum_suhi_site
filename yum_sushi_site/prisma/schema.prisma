// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Reservation {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  date      String
  time      String
  guests    String
  notes     String?
  createdAt DateTime @default(now())
}